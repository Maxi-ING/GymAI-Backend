# Copiar como .env y reemplazar el secreto. Sin credenciales reales.
DATABASE_URL=postgresql+psycopg://gym:gym_local@localhost:5432/gym
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
TOKEN_MINUTES=60
AUTH_RATE_LIMIT=true
# En producción: URL de Supabase Session pooler con sslmode=require.
